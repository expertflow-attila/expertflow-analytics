# ---------------------------------------------------------------------------
# Funnel Intelligence OS — environment configuration
# Copy to `.env` and fill in. Every variable is validated at boot (src/env.ts).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Postgres connection string. With docker-compose the default below just works.
DATABASE_URL="postgres://fios:fios@localhost:5432/fios"

# Public URL of this deployment. Used for the tracking SDK snippet and auth.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional; Auth.js infers this on Vercel.
# AUTH_URL="http://localhost:3000"

# --- Encryption -------------------------------------------------------------
# 32-byte key, base64 encoded. Encrypts integration secrets and BYO AI keys
# at rest. Generate with: openssl rand -base64 32
# NEVER rotate without re-encrypting existing secrets.
ENCRYPTION_KEY=""

# --- Redis (optional) -------------------------------------------------------
# When absent the app falls back to in-process rate limiting and cron-driven
# job execution. Recommended for production self-hosting.
# REDIS_URL="redis://localhost:6379"

# --- Background jobs --------------------------------------------------------
# Shared secret for /api/cron/* endpoints (Vercel Cron / any scheduler).
CRON_SECRET=""

# --- Stripe (optional) ------------------------------------------------------
# Configured per-project in the UI; this is only the platform-level fallback.
# STRIPE_WEBHOOK_SECRET=""

# --- AI (optional) ----------------------------------------------------------
# The whole product works without AI. These are fallbacks when an organization
# has not supplied its own key (Bring Your Own Key is the default).
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434"

# --- Feature flags ----------------------------------------------------------
FEATURE_AI_ANALYST="true"
FEATURE_MCP_SERVER="false"
FEATURE_CLICKHOUSE="false"
FEATURE_OBSERVED_JOURNEY="true"

# --- ClickHouse (optional, feature-flagged) --------------------------------
# CLICKHOUSE_URL="http://localhost:8123"
# CLICKHOUSE_USER="default"
# CLICKHOUSE_PASSWORD=""
# CLICKHOUSE_DATABASE="fios"
